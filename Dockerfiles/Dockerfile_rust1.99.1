# docker buildx build \
#   --platform linux/arm/v7 \
#   -t ha-python-rust:1.99.1 \
#   -f Dockerfile_rust1.99.1 \
#   --build-arg RUST198=ha-python-rust:1.98 \
#   --load .

ARG BASE=ghcr.io/villgzs/hass-core32-basepython:2026.10.0
ARG RUST198=ha-python-rust:1.98

# ============================================================
# 0. Build eszközök
# ============================================================
FROM ${BASE} AS deps

ENV CARGO_TERM_QUIET=true

RUN apk add --no-cache \
    curl \
    build-base \
    musl-dev \
    openssl-dev \
    linux-headers \
    pkgconf \
    cmake \
    python3 \
    git \
    ninja \
    patch \
    xz \
    tar

# ============================================================
# 1. Forrás letöltése és kicsomagolása
# ============================================================
FROM deps AS src

WORKDIR /tmp
RUN set -eux; \
    curl -LO https://static.rust-lang.org/dist/rustc-1.99.1-src.tar.gz; \
    tar xf rustc-1.99.1-src.tar.gz; \
    rm rustc-1.99.1-src.tar.gz

# ============================================================
# 2. Előző toolchain bemásolása + config.toml
# ============================================================
FROM src AS config

# Az 1.98-as toolchain bemásolása
COPY --from=${RUST198} /opt/rust-1.98 /opt/rust-1.98

WORKDIR /tmp/rustc-1.99.1-src
RUN printf '%s\n' \
    '[build]' \
    'docs = false' \
    'compiler-docs = false' \
    'extended = true' \
    'tools = ["cargo"]' \
    'jobs = 8' \
    'rustc = "/opt/rust-1.98/bin/rustc"' \
    'cargo = "/opt/rust-1.98/bin/cargo"' \
    '' \
    '[rust]' \
    'codegen-units = 1' \
    'lto = "off"' \
    'debug = false' \
    'debuginfo-level = 0' \
    > config.toml

# ============================================================
# 3. Build
# ============================================================
FROM config AS build

WORKDIR /tmp/rustc-1.99.1-src
RUN ./x.py build --stage 2

# ============================================================
# 4. Install
# ============================================================
FROM build AS install

WORKDIR /tmp/rustc-1.99.1-src
RUN ./x.py install --prefix=/usr/local && \
    /usr/local/bin/rustc --version && \
    /usr/local/bin/cargo --version

# ============================================================
# 5. Végső tiszta image
# ============================================================
FROM ${BASE}

COPY --from=install /usr/local /usr/local

ENV PATH=/usr/local/bin:$PATH

RUN rustc --version && cargo --version

# Opcionális
RUN pip install --no-cache-dir maturin
