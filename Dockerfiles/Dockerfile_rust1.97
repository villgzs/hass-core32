# docker buildx build \
#   --platform linux/arm/v7 \
#   -t ha-python-rust:1.97 \
#   -f Dockerfile_rust1.97 \
#   --load .

ARG BASE=ghcr.io/villgzs/hass-core32-basepython:2026.10.0

# ============================================================
# 0. közös alap
# ============================================================
FROM ${BASE} AS base

ENV CARGO_TERM_QUIET=true

RUN apk add --no-cache \
    curl \
    build-base \
    musl-dev \
    openssl-dev \
    linux-headers \
    pkgconf \
    cmake \
    python3 \
    git \
    ninja \
    patch \
    xz \
    tar

# ============================================================
# 1. lépés: Alpine 1.96 → Rust 1.97
# ============================================================
FROM base AS rust-1.97

RUN apk add --no-cache rust cargo

WORKDIR /tmp
RUN set -eux; \
    curl -LO https://static.rust-lang.org/dist/rustc-1.97.0-src.tar.gz; \
    tar xf rustc-1.97.0-src.tar.gz; \
    cd rustc-1.97.0-src; \
    \
    printf '%s\n' \
        '[build]' \
        'docs = false' \
        'compiler-docs = false' \
        'extended = true' \
        'tools = ["cargo"]' \
        'jobs = 8' \
        'rustc = "/usr/bin/rustc"' \
        'cargo = "/usr/bin/cargo"' \
        '' \
        '[rust]' \
        'codegen-units = 1' \
        'lto = "off"' \
        'debug = false' \
        'debuginfo-level = 0' \
        > config.toml; \
    \
    ./x.py build --stage 2; \
    ./x.py install --prefix=/opt/rust-1.97; \
    \
    /opt/rust-1.97/bin/rustc --version; \
    \
    cd /; \
    rm -rf /tmp/rustc-1.97.0-src /tmp/rustc-1.97.0-src.tar.gz

# ============================================================
# Végső image – csak a 1.97 toolchain
# ============================================================
FROM ${BASE}

COPY --from=rust-1.97 /opt/rust-1.97 /opt/rust-1.97

ENV PATH=/opt/rust-1.97/bin:$PATH

RUN rustc --version && cargo --version
